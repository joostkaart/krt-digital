---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = 'Klaar om te sparren?',
  description = 'Vertel me over je uitdaging. Ik denk graag vrijblijvend met je mee.',
  buttonText = 'Neem contact op',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="bg-surface-high">
  <div class="mx-auto max-w-[var(--container-max)] px-8 md:px-12 py-24 md:py-32">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-center">
      {/* Left: large display heading */}
      <div class="md:col-span-7">
        <h2 class="text-4xl md:text-5xl lg:text-6xl text-on-surface leading-[1.1]">{title}</h2>
      </div>

      {/* Right: description + CTA */}
      <div class="md:col-span-5">
        <p class="text-on-surface-variant text-base leading-relaxed mb-8 font-[var(--font-serif)]">{description}</p>
        <a
          href={buttonHref}
          class="btn-primary"
        >
          {buttonText}
        </a>
      </div>
    </div>
  </div>
</section>
