---
interface Props {
  class?: string;
  imgClass?: string;
}

const { class: className = '', imgClass = 'h-10' } = Astro.props;
---

<a href="/" class={`inline-flex items-center no-underline group ${className}`} aria-label="KRT Digital — Naar homepage">
  <img src="/krt-logo.png" alt="KRT Digital" class={`w-auto ${imgClass}`} />
</a>
