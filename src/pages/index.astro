---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "KRT Digital",
  "description": "Interim, fractional & freelance management en strategische diensten op het gebied van Digital Marketing & E-commerce.",
  "url": "https://krtdigital.nl",
  "founder": {
    "@type": "Person",
    "name": "Joost Kaart",
    "jobTitle": "Digital Marketing & E-commerce Consultant",
    "url": "https://www.linkedin.com/in/joostkaart"
  },
  "areaServed": { "@type": "Country", "name": "Netherlands" },
  "serviceType": [
    "Interim Digital Marketing Management",
    "Fractional CMO",
    "Digital Marketing Strategy",
    "E-commerce Management",
    "Growth Marketing"
  ]
};

const services = [
  {
    num: '01',
    title: 'Interim & Fractional Management',
    description: 'Invulling als (fractional) Head of Digital, E-commerce Manager of Marketing Director. Fulltime embedded of parttime leiderschap.',
    icon: 'management',
  },
  {
    num: '02',
    title: 'Strategie & Groei',
    description: 'Van digitale strategie en channel mix tot full-funnel groeimarketing en conversie-optimalisatie.',
    icon: 'strategy',
  },
  {
    num: '03',
    title: 'Martech & Data',
    description: 'Selectie en implementatie van je marketing technology stack. Data-gedreven marketing opzetten en optimaliseren.',
    icon: 'martech',
  },
  {
    num: '04',
    title: 'Team & Organisatie',
    description: 'Opbouwen, coachen en opschalen van digital marketing teams. Insource vs. outsource vraagstukken.',
    icon: 'team',
  },
];

const clients = ['NS', 'Sunweb', 'Pricewise'];

const stats = [
  { value: '16+', label: 'Jaar ervaring in digital marketing & e-commerce' },
  { value: '3', label: 'Inzetvormen: interim, fractional of project-based' },
  { value: '360°', label: 'Van strategie en team tot performance en martech' },
];
---

<BaseLayout
  title="KRT Digital — Interim, Fractional & Freelance Digital Marketing"
  description="Joost Kaart biedt interim, fractional en freelance management en strategische diensten op het gebied van Digital Marketing & E-commerce. 16+ jaar ervaring."
  structuredData={structuredData}
>
  {/* ========== HERO — photo + asymmetric headline ========== */}
  <section class="relative overflow-hidden">
    {/* Soft gold ambient glow behind the portrait */}
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <div class="absolute -left-32 top-1/4 w-[40rem] h-[40rem] rounded-full opacity-[0.10] blur-[120px]" style="background: radial-gradient(circle, #e6c185 0%, transparent 70%)"></div>
    </div>

    <div class="mx-auto max-w-[var(--container-max)] px-8 md:px-12 py-16 md:py-24 lg:py-28 w-full relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 items-center">
        {/* Portrait — layered into the navy via gradient scrim, no hard box */}
        <div class="md:col-span-5 lg:col-span-5 relative">
          <div class="relative max-w-sm mx-auto md:mx-0">
            <img
              src="/joost-kaart.jpeg"
              alt="Joost Kaart — Digital Marketing & E-commerce consultant"
              class="w-full h-auto rounded-[0.25rem] object-cover"
              style="filter: saturate(0.8) contrast(1.03) brightness(0.92);"
              width="889"
              height="772"
            />
            {/* Scrim: blends photo edges into the surface so it doesn't feel pasted on */}
            <div class="absolute inset-0 rounded-[0.25rem] pointer-events-none" style="background: linear-gradient(180deg, rgba(14,20,29,0.55) 0%, rgba(14,20,29,0) 28%, rgba(14,20,29,0) 48%, rgba(14,20,29,0.92) 100%), linear-gradient(105deg, rgba(14,20,29,0) 48%, rgba(14,20,29,0.6) 100%);"></div>
          </div>
        </div>

        {/* Headline block — offset right for asymmetry */}
        <div class="md:col-span-7 lg:col-span-6 lg:col-start-7">
          <span class="font-[var(--font-label)] text-[0.6875rem] uppercase tracking-[0.25em] text-on-surface-muted font-medium">
            Digital Marketing & E-commerce
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.05] mt-5 md:mt-6">
            Interim, Fractional &
            <span class="text-primary">Freelance</span> Digital
            Marketing Leadership
          </h1>
          <p class="text-on-surface-variant text-base md:text-lg leading-relaxed mt-7 md:mt-8 max-w-md font-[var(--font-serif)]">
            16+ jaar ervaring in digital marketing & e-commerce. Strategisch en hands-on. Van interim management tot fractional CMO.
          </p>
          <div class="flex flex-wrap items-center gap-4 mt-9 md:mt-10">
            <a href="/contact" class="btn-primary">Neem contact op</a>
            <a href="/diensten" class="btn-ghost">Bekijk diensten</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========== CLIENT LOGOS — tonal layering strip ========== */}
  <section class="bg-surface-low">
    <div class="mx-auto max-w-[var(--container-max)] px-8 md:px-12 py-10 md:py-12">
      <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-16">
        <span class="font-[var(--font-label)] text-[0.6875rem] uppercase tracking-[0.25em] text-on-surface-muted font-medium whitespace-nowrap shrink-0">
          Gewerkt voor
        </span>
        <div class="h-px bg-surface-high flex-1 hidden md:block"></div>
        <div class="flex items-center gap-8 md:gap-14 flex-wrap">
          {clients.map((client) => (
            <span class="text-xl md:text-2xl font-[var(--font-display)] text-primary/40 hover:text-primary/70 transition-colors select-none">
              {client}
            </span>
          ))}
        </div>
        <div class="h-px bg-surface-high flex-1 hidden md:block"></div>
      </div>
    </div>
  </section>

  {/* ========== EXPERTISE — 4-card grid ========== */}
  <section>
    <div class="mx-auto max-w-[var(--container-max)] px-8 md:px-12 py-24 md:py-32">
      {/* Section header — asymmetric */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-14 md:mb-20">
        <div class="md:col-span-6">
          <span class="font-[var(--font-label)] text-[0.6875rem] uppercase tracking-[0.25em] text-on-surface-muted font-medium">Expertise</span>
          <h2 class="text-4xl md:text-5xl mt-4">Wat ik voor je kan doen</h2>
        </div>
        <div class="md:col-span-4 md:col-start-9 flex items-end">
          <p class="text-on-surface-variant text-base leading-relaxed font-[var(--font-serif)]">
            Senior digital marketing expertise, flexibel inzetbaar. Van strategisch advies tot operationeel leiderschap.
          </p>
        </div>
      </div>

      {/* Cards — lifted surfaces, no borders, hover glow */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {services.map((service) => (
          <a
            href="/diensten"
            class="card group no-underline relative flex flex-col bg-surface-high rounded-[0.25rem] p-7 md:p-8 transition-transform duration-300 hover:-translate-y-1"
          >
            {/* Icon */}
            <div class="text-primary/70 group-hover:text-primary transition-colors duration-300 mb-7 md:mb-9">
              {service.icon === 'management' && (
                <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="20" cy="8" r="4"/>
                  <line x1="20" y1="12" x2="20" y2="22"/>
                  <line x1="20" y1="22" x2="10" y2="32"/>
                  <line x1="20" y1="22" x2="30" y2="32"/>
                  <circle cx="10" cy="34" r="2.5"/>
                  <circle cx="30" cy="34" r="2.5"/>
                  <line x1="12" y1="18" x2="28" y2="18" stroke-dasharray="2 3"/>
                </svg>
              )}
              {service.icon === 'strategy' && (
                <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2">
                  <path d="M8 32L16 20L24 24L34 8"/>
                  <polyline points="26,8 34,8 34,16"/>
                  <circle cx="16" cy="20" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                  <circle cx="24" cy="24" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                  <circle cx="34" cy="8" r="2" fill="currentColor" stroke="none" opacity="0.5"/>
                </svg>
              )}
              {service.icon === 'martech' && (
                <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="20" cy="20" r="4"/>
                  <circle cx="8" cy="10" r="3"/>
                  <circle cx="32" cy="10" r="3"/>
                  <circle cx="8" cy="32" r="3"/>
                  <circle cx="32" cy="32" r="3"/>
                  <line x1="17" y1="17" x2="10" y2="12"/>
                  <line x1="23" y1="17" x2="30" y2="12"/>
                  <line x1="17" y1="23" x2="10" y2="30"/>
                  <line x1="23" y1="23" x2="30" y2="30"/>
                </svg>
              )}
              {service.icon === 'team' && (
                <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="14" cy="12" r="3.5"/>
                  <circle cx="26" cy="12" r="3.5"/>
                  <circle cx="20" cy="26" r="3.5"/>
                  <path d="M14 16C14 16 10 18 10 22" stroke-linecap="round"/>
                  <path d="M26 16C26 16 30 18 30 22" stroke-linecap="round"/>
                  <path d="M17 28C17 28 14 30 14 34" stroke-linecap="round"/>
                  <path d="M23 28C23 28 26 30 26 34" stroke-linecap="round"/>
                  <line x1="17" y1="13" x2="23" y2="13" stroke-dasharray="2 2"/>
                </svg>
              )}
            </div>

            {/* Title */}
            <h3 class="text-xl md:text-2xl leading-snug text-on-surface group-hover:text-primary transition-colors duration-300">{service.title}</h3>

            {/* Description */}
            <p class="text-on-surface-variant text-sm leading-relaxed font-[var(--font-serif)] mt-4 flex-1">{service.description}</p>

            {/* Arrow */}
            <span class="mt-8 text-on-surface-muted group-hover:text-primary transition-colors inline-flex" aria-hidden="true">
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-12 md:mt-16">
        <a href="/diensten" class="btn-ghost">Bekijk alle diensten</a>
      </div>
    </div>
  </section>

  {/* ========== STATS — glowing gold numbers ========== */}
  <section class="bg-surface-low relative overflow-hidden">
    <div class="mx-auto max-w-[var(--container-max)] px-8 md:px-12 py-24 md:py-32 relative z-10">
      <div class="text-center mb-16 md:mb-20">
        <span class="font-[var(--font-label)] text-[0.6875rem] uppercase tracking-[0.25em] text-on-surface-muted font-medium">In cijfers</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-14 md:gap-12">
        {stats.map((stat) => (
          <div class="text-center relative">
            {/* Ambient glow behind the number */}
            <div class="absolute left-1/2 top-0 -translate-x-1/2 w-48 h-32 rounded-full opacity-[0.18] blur-[60px] pointer-events-none" style="background: radial-gradient(circle, #e6c185 0%, transparent 70%)" aria-hidden="true"></div>
            <div class="relative font-[var(--font-display)] text-6xl md:text-7xl lg:text-8xl text-primary leading-none">{stat.value}</div>
            <p class="relative text-on-surface-variant text-sm leading-relaxed font-[var(--font-serif)] mt-6 max-w-[16rem] mx-auto">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ========== CTA ========== */}
  <CTASection />
</BaseLayout>
